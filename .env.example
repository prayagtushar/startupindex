# Copy to .env. The API and retrieval library read ISRA_-prefixed vars; ingest
# reads plain DATABASE_URL.

# Database, used by the API and the retrieval library.
ISRA_DATABASE_URL=postgresql://isra:isra@localhost:5432/isra
# Used by the ingest job (apps/ingest). Point at the same database.
DATABASE_URL=postgresql://isra:isra@localhost:5432/isra

# LLM (OpenRouter), required for POST /chat.
ISRA_OPENROUTER_API_KEY=sk-or-...
# A ":free" model to stay at $0; the suffix is required and the free roster rotates.
ISRA_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
ISRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web app, server-side only. Base URL of the deployed API, no trailing slash.
API_URL=http://localhost:8000

# Shared between the API and the web app. The web app proxies every call
# server-side, so without this the API sees one hosting egress IP for every
# visitor and all per-IP rate limits collapse into a single shared bucket.
# Must be identical on both sides.
ISRA_PROXY_SECRET=

# Required by POST /ingest, which rewrites the corpus. Unset means /ingest is
# closed, so a deployment that forgets it fails closed rather than open.
ISRA_ADMIN_KEY=

# Answers POST /chat will generate per UTC day. This is the ceiling that caps
# LLM spend, since per-IP limits do nothing against a bot pool.
# 0 stops answering without a redeploy. -1 removes the cap.
ISRA_DAILY_CHAT_LIMIT=200

# Proxy hops appended to X-Forwarded-For. 1 is correct behind Cloud Run.
# Set 0 when nothing sits in front, or rate limits key on the proxy address.
ISRA_TRUSTED_PROXY_HOPS=1

# Comma-separated origins allowed for direct API calls.
ISRA_CORS_ORIGINS=*

# Langfuse tracing (optional). Disabled unless both keys are set.
ISRA_LANGFUSE_PUBLIC_KEY=
ISRA_LANGFUSE_SECRET_KEY=
ISRA_LANGFUSE_HOST=https://cloud.langfuse.com
